{
  "expo": {
    "name": "TourTrack",
    "slug": "tournatrack",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#2c3e50"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.davidonq.tournatrack",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1a252f"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.davidonq.tournatrack"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f262ea3d-048b-42ff-9953-86c4abd51306"
      }
    }
  }
}
